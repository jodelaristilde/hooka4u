generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid()) @map("_id")
  username  String   @unique
  password  String
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

model VerificationToken {
  id         String   @id @default(uuid()) @map("_id")
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// NOTE on `site`: this app serves two domains (vipservice4u.us and
// jaeky.us) from one shared database, partitioned by this field. Because
// this is MongoDB via Prisma, `@default("vipservice4u")` only applies to
// NEW documents written through Prisma — it does NOT backfill the field
// onto documents that already existed before this field was added.
// Application code must treat a MISSING/null `site` on an old document as
// belonging to "vipservice4u" (see src/lib/site.ts for the shared helper
// that applies this null-fallback consistently).
model MenuCategory {
  id        String   @id @default(uuid()) @map("_id")
  name      String
  site      String   @default("vipservice4u")
  hidden    Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Was a plain `name @unique`. Changed to compound so both sites can each
  // have their own "DRINKS" category, etc., without colliding. Legacy
  // category documents have no `site` field yet, so read/lookup code still
  // needs the null-fallback treatment described above when matching
  // vipservice4u's categories.
  @@unique([name, site])
}

model MenuItems {
  id          String      @id @default(uuid()) @map("_id")
  name        String
  description String?
  image       String?     // Add this line for base64 image storage
  price       Float
  category    String?     // Free-text category name, e.g. "FOOD", "DRINKS", or any custom category
  available   Boolean     @default(false)
  site        String      @default("vipservice4u")
  // Username of whoever added this item (e.g. "jo", "karen"), so an admin
  // can view/filter one user's menu without logging into their account.
  // Nullable because items created before this field existed have no
  // creator on record — the admin UI lets those be assigned afterward.
  createdByUsername String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  OrderItem   OrderItem[]
}

// A reusable library of item photos/descriptions, separate from the live
// menu (MenuItems). Washup and the Menu page's "Delete All" only ever touch
// MenuItems, never this — so once a photo + description is saved here, it
// can be reused to quickly re-populate the live menu for a new event
// without re-uploading and re-editing the same image every time.
model MenuItemTemplate {
  id          String   @id @default(uuid()) @map("_id")
  name        String
  description String?
  image       String?
  category    String?
  site        String   @default("vipservice4u")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id           String      @id @default(uuid()) @map("_id")
  orderNumber  Int?
  customerName String
  paymentType  String?     @default("CASH")
  Seating      String
  subtotal     Float
  status       String      @default("PENDING")
  site         String      @default("vipservice4u")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]
}

enum PaymentType {
  CASH
  CARD
}

model OrderItem {
  id        String   @id @default(cuid()) @map("_id")
  orderId   String
  productId String
  quantity  Int
  order     Order    @relation(fields: [orderId], references: [id])
  product   MenuItems  @relation(fields: [productId], references: [id])
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}
